# Strings
APP_ENV="development"
DB_HOST="localhost"

# Integers (Whole Numbers)
SERVER_PORT=8080
MAX_CONNECTIONS=5

# Floats (Decimal Numbers)
TIMEOUT_LIMIT=4.5
TAX_RATE=0.15

# Booleans (True/False)
DEBUG=true
ENABLE_SIGNUPS=false

# Tuples (Immutable Sequences)
ALLOWED_COLORS="red,green,blue"
DATABASE_COORDINATES="45.12,-122.33"
ADMIN_IDS="(1001, 1002, 1003)"

#lists (Mutable Sequences)
FRUITS="apple,banana,cherry"
PRIME_NUMBERS="2,3,5,7"
USER_ROLES='["admin", "editor", "viewer"]'

# dictionary using JSON format
APP_CONFIG_JSON='{"theme": "dark", "retries": 3, "debug": true}'

# dictionary using Python literal format
APP_CONFIG='{"theme": "dark", "retries": 3, "debug": True}'

# dictionary using prefix
DB_HOST="localhost"
DB_PORT=5432
DB_USER="admin"

DB_USER=postgres_admin
DB_PASS=SuperSecret123
DB_HOST=localhost
DB_PORT=5432
DB_NAME=production_db

# Construct the full connection string using expansion
LOCAL_DATABASE_URL=postgresql://${DB_USER}:${DB_PASS}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# multi-line value using line continuation
MY_PRIVATE_RSA_KEY="-----BEGIN RSA PRIVATE KEY-----
MIIEowIBAAKCAQEA0Y...
...everything inside quotes...
-----END RSA PRIVATE KEY-----"

# multi-line value using line escape sequences
MY_ANOTHER_RSA_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA0Y...\n...everything inside quotes...\n-----END RSA PRIVATE KEY-----"
# multi-line value using escape sequences works well with single quotes
MY_SINGLE_QUOTE_RSA_KEY='-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA0Y...\n...everything inside quotes...\n-----END RSA PRIVATE KEY-----'

# validating the .env file using pydantic-settings or marshmallow
DB_PORT_VALIDATOR=6666
DEBUG_VALIDATOR=true
HTTP_URL_VALIDATOR=http://admin:SuperSecret123@localhost:5432/production_db
JWT_SECRET_KEY_VALIDATOR=complex_secret_key_123

DB_NAME_VALIDATOR=production_db